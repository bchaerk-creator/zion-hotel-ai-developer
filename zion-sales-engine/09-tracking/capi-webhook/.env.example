# Copie para .env (FORA do repositorio) ou cadastre cada variavel no painel da hospedagem.
# NUNCA coloque valores reais neste arquivo e NUNCA envie token pelo chat.

# --- Meta (obrigatorio para enviar) ---
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Versao da Graph API. Confira a versao vigente na documentacao da Meta antes de ligar.
META_GRAPH_VERSION=v21.0
# Codigo da aba "Testar eventos". Se preenchido, os eventos NAO contam como conversao. Deixe vazio em producao.
META_TEST_EVENT_CODE=
# Para testes locais com servidor simulado. Em producao, deixe vazio.
META_GRAPH_BASE=

# --- Seguranca do webhook (obrigatorio) ---
WEBHOOK_SECRET=
# Onde o segredo chega: header (padrao cm-token do ClickMax), query ou caminho no corpo.
WEBHOOK_SECRET_HEADER=cm-token
WEBHOOK_SECRET_QUERY=
WEBHOOK_SECRET_BODY_PATH=

# --- Formato do webhook ---
# clickmax-delivery (webhook de entrega da oferta, payload personalizado, variaveis documentadas)
# clickmax-out (integracao de saida SALE_MADE / REFUND_MADE; nomes de campos [NC], conferir no teste)
# ticto (webhook Ticto v2; nomes de campos [NC], conferir no teste)
# custom (use FIELD_MAP_JSON)
ADAPTER=clickmax-delivery
# Sobrescreve/estende o mapeamento. Ex.: {"amount":["transaction.amount"],"email":["buyerEmail"]}
FIELD_MAP_JSON=
# cents (ClickMax guarda centavos) ou reais. O valor e dividido UMA vez, aqui.
AMOUNT_UNIT=cents
# Parametro de URL que diz qual gatilho chegou (integracao de saida do ClickMax nao traz o nome do evento no corpo)
EVENT_QUERY_PARAM=evento

# --- Regras ---
PAID_STATUSES=paid,approved,completed,authorized,captured
REFUND_STATUSES=refunded,refunding,chargedback,chargeback,canceled,cancelled
# Faixa de seguranca do valor em reais (barra erro de unidade, ex. 0,97 ou 9700)
MIN_VALUE=1
MAX_VALUE=2000
CURRENCY=BRL
# Se o webhook nao trouxer hora do pagamento, usa a hora do recebimento
EVENT_TIME_FALLBACK_NOW=true
# Meta so aceita eventos com ate 7 dias
MAX_EVENT_AGE_DAYS=7
# Origem exibida no evento
EVENT_SOURCE_URL_DEFAULT=
# Reembolso: registrar sempre; enviar evento proprio so se ligado
SEND_REFUND_EVENT=false
REFUND_EVENT_NAME=ZionRefund

# --- Idempotencia ---
# memory (nao sobrevive a reinicio) ou caminho de arquivo (guarda so event_id e status, sem dados pessoais)
DEDUPE_STORE=memory
PORT=8787
MAX_BODY_BYTES=262144
