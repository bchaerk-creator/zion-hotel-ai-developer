# Zion Hotel AI Developer - Configuração de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# OpenAI API Configuration
OPENAI_API_KEY=sua_chave_aqui
OPENAI_API_BASE=https://api.openai.com/v1

# Modelo padrão para tarefas gerais (custo-benefício)
ZION_MODEL=gpt-5-mini

# Modelo para raciocínio complexo (análises financeiras, estratégicas)
ZION_THINKING_MODEL=gpt-5

# Modelo para processamento de alto volume (diagnósticos rápidos)
ZION_FAST_MODEL=gpt-5-nano

# Configurações do Agente
ZION_AGENT_NAME=Zion Hotel AI Developer
ZION_AGENT_VERSION=1.0.0
ZION_LOG_LEVEL=INFO

# Configurações de Output
ZION_OUTPUT_DIR=./output
ZION_REPORTS_FORMAT=markdown
ZION_LANGUAGE=pt-BR

# 21st.dev (MCP de geração de componentes de UI) - ver docs/MCP.md
# Precisa ser exportada no shell, não apenas neste arquivo:
#   export API_KEY_21ST="sua_chave_aqui"
API_KEY_21ST=sua_chave_aqui
